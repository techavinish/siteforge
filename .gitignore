# secrets & local config — never committed
.env
.env.*
!.env.example
*.pem
*-key.json
serviceAccount*.json

# python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# node
node_modules/
dist/
*.local
.firebase/
*.tsbuildinfo

# terraform — state and variable values stay local; the lock file IS committed
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# os / editor
.DS_Store
.idea/
.vscode/
db/cloud-sql-proxy
